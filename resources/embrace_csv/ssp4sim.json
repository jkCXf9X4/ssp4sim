{
    "simulation" :
    {
        "ssp": "./resources/embrace_csv/ssp.ssp",
        "ssd": "SystemStructure.ssd",
        "start_time":0.0,
        "stop_time":300,
        "timestep": 0.01,
        "tolerance": 1e-4,
        "realtime": false,

        "executor": 
        {
            "method":"jacobi",
            
            "thread_pool_workers": 5,
            "forward_derivatives": true,

            "jacobi":
            {
                "parallel": true,
                "method" : 1
            },
            "seidel":
            {
                "parallel": false
            }
            
        },

        "recording":
        {
            "enable": true,
            "wait_for": true,
            "interval": 0.25,
            "result_file": "./resources/embrace_csv/results/ssp4sim_config1.csv"
        },

        "log":
        {
            "file": "./resources/embrace_csv/results/ssp4sim_config1.log",
            "fmu" : true,
            "level_terminal" : "Warning",
            "level_file" : "Debug",
            "level_json" : "Debug",
            "level_cutelog" : "Debug"
        }
    }
}