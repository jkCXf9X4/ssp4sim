{
    "simulation": {
        "ssp": "resources/reference_ssp/artifacts/models/resources/algebraic_loop.json/baseline",
        "ssd": "SystemStructure.ssd",
        "start_time": 0.0,
        "stop_time": 1.0,
        "timestep": 0.0001,
        "tolerance": 1e-4,
        "realtime": false,
        "working_dir": "./wd/resources/algebraic_loop.json",
        "executor": {
            "method": "jacobi",
            "thread_pool_workers": 5,
            "forward_derivatives": true,
            "jacobi": {
                "parallel": true,
                "method": 1
            },
            "seidel": {
                "parallel": false
            }
        },
        "recording": {
            "csv": {
                "enable": true,
                "interval": 0.25
            },
            "wait_for": true
        },
        "log": {
            "fmu": true,
            "level_terminal": "info",
            "level_file": "info",
            "level_json": "tracel1",
            "level_cutelog": "disable"
        }
    }
}
